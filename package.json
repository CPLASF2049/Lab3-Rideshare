{
  "name": "lab3-rideshare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "高级软件工程 Lab3：沪行网约车微服务，DDD / CQRS / Saga / Outbox",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs services/*/*.test.mjs",
    "test:unit": "node --test --test-isolation=none tests/order.unit.test.mjs tests/frontend.unit.test.mjs",
    "test:component": "node --test --test-isolation=none tests/order.component.test.mjs tests/query.component.test.mjs tests/gateway.component.test.mjs services/*/*.test.mjs",
    "test:e2e": "node scripts/acceptance.mjs",
    "check": "node scripts/check.mjs",
    "reset": "node scripts/reset.mjs"
  }
}
